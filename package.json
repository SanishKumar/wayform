{
  "name": "wayform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "workspaces": [
    "compat/voicegis/upstream/packages/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/compatibility.test.ts",
    "compat:check": "node --import tsx scripts/compat-baseline.ts",
    "compat:record": "node --import tsx scripts/compat-baseline.ts --record",
    "compat:audit": "node scripts/upstream-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
